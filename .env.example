# Copy this file to .env and fill in real values. Never commit .env.
# In GitHub Actions, these are repository secrets instead (see README.md).

# --- Slack (chat:write only -- section 22) ---
# Bot token from "OAuth & Permissions" (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# Channel ID of the private #literature-<you> channel (e.g. C0123456789)
SLACK_CHANNEL_ID=

# --- Database ---
# Path to the SQLite file. In GitHub Actions this is the `state` branch
# checkout of litagent.db; locally it's just a file in the repo root.
DATABASE_PATH=litagent.db

# --- LLM / embeddings ---
# Both currently backed by OpenAI; set the same key for both.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- External data sources ---
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex API key for higher rate limits (apply at https://openalex.org/;
# the old `mailto` polite-pool parameter is deprecated in favour of this).
OPENALEX_API_KEY=

# --- Relevance funnel thresholds (section 11) ---
LEXICAL_CANDIDATE_LIMIT=300
EMBEDDING_CANDIDATE_LIMIT=60
EMBEDDING_SIMILARITY_THRESHOLD=0.2
LLM_CLASSIFY_LIMIT=30
RELEVANCE_SCORE_THRESHOLD=0.4

# --- Paper analysis ---
MAX_PDF_TEXT_CHARS=40000

# --- Misc ---
LOG_LEVEL=INFO
ENVIRONMENT=development
